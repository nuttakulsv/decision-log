{
  "name": "decision-log-cli",
  "version": "0.1.0",
  "description": "Architecture decision records that show up in the pull requests they govern. CLI, static site and GitHub Action.",
  "keywords": [
    "adr",
    "architecture-decision-record",
    "architecture",
    "decision-log",
    "madr",
    "github-action",
    "pull-request",
    "documentation",
    "tech-lead"
  ],
  "homepage": "https://github.com/nuttakulsv/decision-log#readme",
  "bugs": "https://github.com/nuttakulsv/decision-log/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuttakulsv/decision-log.git"
  },
  "license": "MIT",
  "author": "nuttakulsv",
  "type": "module",
  "bin": {
    "decision-log": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "oxlint src test scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "image": "tsx scripts/readme-image.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "marked": "^18.0.14",
    "picomatch": "^4.0.7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.5",
    "@types/picomatch": "^4.0.3",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
